# Base URL of the API the client reads data from.
# The Next.js rewrite proxies browser requests `/api/*` to this address,
# so the API paths stay the same when you change only the host/IP.
#
# Read by docker-compose.yml into both `build.args.API_URL` and
# `environment.API_URL`. Copy this file to `.env` and edit it.
#
# Change the address (e.g. an API server on another machine):
#   API_URL=http://192.168.1.50:3000
# then rebuild the client - the rewrite destination is baked into
# .next/routes-manifest.json at build time, not resolved at runtime:
#   docker compose build client && docker compose up -d
#
# Default: the server container in the same compose network.
API_URL=http://server:3000
