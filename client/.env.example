# For running the client outside Docker (`npm run dev`) only.
# Copy to `client/.env.local` (git-ignored, and excluded from the Docker
# build by `.dockerignore` - the image gets its value from the build ARG).
#
# Next.js reads this when it loads the config, so pointing the dev server at
# another IP needs no build - just restart `npm run dev`.
#
# Example: API_URL=http://192.168.1.50:3000
API_URL=http://localhost:3000
